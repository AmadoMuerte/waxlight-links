---
import { BookOpen, SquareCode } from "@lucide/astro";
import Brand from "../components/Brand.astro";
import DownloadLinks from "../components/DownloadLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDownloads } from "../lib/github";

const downloads = await getDownloads();
---

<BaseLayout
  title="Waxlight Links"
  description="Open Vintage Story mods and servers directly in Waxlight Launcher."
>
  <main>
    <header><Brand compact /></header>
    <section class="hero">
      <p class="eyebrow">WAXLIGHT LINKS</p>
      <h1>Open Vintage Story content in Waxlight.</h1>
      <p>Shared mods and servers open directly in the launcher.</p>
      <DownloadLinks {...downloads} />
      <nav aria-label="Project links">
        <a href="https://github.com/AmadoMuerte/Waxlight-launcher"
          ><SquareCode size={16} aria-hidden="true" /> GitHub</a
        >
        <a href="https://amadomuerte.github.io/waxlight-wiki/en/"
          ><BookOpen size={16} aria-hidden="true" /> Docs</a
        >
      </nav>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    width: min(100% - 40px, 680px);
    margin: 0 auto;
    padding: 28px 0 64px;
    text-align: center;
  }
  header {
    display: flex;
    justify-content: center;
  }
  nav {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 8px;
    color: #a9a39d;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }
  nav a:hover {
    color: #eeeae4;
    background: #ffffff0a;
  }
  .hero {
    margin-top: clamp(72px, 12vh, 100px);
  }
  .eyebrow {
    margin: 0;
    color: #e5a84b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.23em;
  }
  h1 {
    max-width: 620px;
    margin: 12px auto 13px;
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .hero > p:last-of-type {
    margin: 0 auto;
    color: #aaa49e;
    font-size: 15px;
    line-height: 1.6;
  }
  @media (max-width: 560px) {
    .hero {
      margin-top: 64px;
    }
  }
</style>
