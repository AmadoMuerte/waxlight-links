---
import { ArrowRight, ExternalLink } from "@lucide/astro";
import Brand from "../components/Brand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { config } from "../lib/config";
---

<BaseLayout
  title="Link not found | Waxlight Links"
  description="This Waxlight Link could not be found."
>
  <main>
    <Brand />
    <section>
      <p>404</p>
      <h1>Link not found</h1>
      <p class="message">Check the address, or return to Waxlight Links.</p>
      <a href="/">Go to Waxlight Links <ArrowRight size={17} aria-hidden="true" /></a>
      <a href={`https://github.com/${config.githubRepository}`} class="secondary"
        >Waxlight on GitHub <ExternalLink size={15} aria-hidden="true" /></a
      >
    </section>
  </main>
</BaseLayout>

<style>
  main {
    width: min(100% - 40px, 850px);
    margin: 0 auto;
    padding: 34px 0;
  }
  section {
    max-width: 520px;
    margin: 88px auto 0;
    padding: clamp(24px, 5vw, 36px);
    border: 1px solid #302d31;
    border-radius: 14px;
    background: #151417;
    box-shadow: 0 18px 44px #0003;
  }
  p {
    color: #e5a84b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }
  h1 {
    margin: 7px 0 0;
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 46px);
    font-weight: 600;
    line-height: 1;
  }
  .message {
    margin: 14px 0 6px;
    color: #aaa49e;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.55;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 12px 8px 0 0;
    padding: 12px 16px;
    border-radius: 9px;
    color: #20150b;
    background: #e5a84b;
    font-weight: 800;
    text-decoration: none;
  }
  .secondary {
    color: #ded8d1;
    background: #242225;
  }
</style>
