---
const compact = Astro.props.compact ?? false;
---

<a href="/" class:list={["brand", { compact }]} aria-label="Waxlight Links home">
  <img
    src="https://raw.githubusercontent.com/AmadoMuerte/Waxlight-launcher/main/docs/waxlight.png"
    alt=""
    width="48"
    height="48"
  />
  <span>
    <strong>Waxlight</strong>
    <small>LINKS</small>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: inherit;
    text-decoration: none;
  }
  img {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    object-fit: cover;
  }
  strong,
  small {
    display: block;
  }
  strong {
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 600;
    line-height: 0.9;
  }
  small {
    margin-top: 5px;
    color: #a39b92;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.28em;
  }
  .compact img {
    width: 36px;
    height: 36px;
  }
</style>
